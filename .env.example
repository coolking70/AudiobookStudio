# 复制为 .env（已被 .gitignore 忽略，绝不会提交），填入真实 key 后 `source .env`
# Agnes：OpenAI 兼容接口，base_url=https://apihub.agnes-ai.com/v1 model=agnes-2.0-flash
export AGNES_API_KEY="在这里粘贴你的-agnes-api-key"

# IndexTTS2：默认会自动使用上层目录 ../index-tts 和它的 .venv。
# 如需换目录或 Python 环境，可按需设置：
# export INDEX_TTS_ROOT="I:\\code\\aitts\\index-tts"
# export INDEX_TTS_PYTHON_EXE="I:\\code\\aitts\\index-tts\\.venv\\Scripts\\python.exe"
# export INDEX_TTS_MODEL_DIR="I:\\code\\aitts\\index-tts\\checkpoints"
# 实测推荐默认值：fp16 + torch_compile + beams=1 + top_k=20。
# torch_compile 首次生成会有 warmup，长会话/整章批量生成收益更明显。
# export INDEX_TTS_USE_FP16="1"
# export INDEX_TTS_USE_CUDA_KERNEL="0"
# export INDEX_TTS_USE_DEEPSPEED="0"
# export INDEX_TTS_USE_TORCH_COMPILE="1"
# export INDEX_TTS_NUM_BEAMS="1"
# export INDEX_TTS_TEMPERATURE="0.8"
# export INDEX_TTS_TOP_P="0.8"
# export INDEX_TTS_TOP_K="20"
# export INDEX_TTS_MAX_TEXT_TOKENS="120"
